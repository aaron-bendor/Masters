<configuration>
    <input>
        <net-file value="net.net.xml"/>
        <route-files value="routes.xml"/>
        <additional-files value="edgedata.intr.add.xml"/>
    </input>
    <time>
        <begin value="0"/>
        <end value="14400"/>
    </time>
    <output>
        <vehroute-output value="vehroutes.intr.xml"/>
        <vehroute-output.exit-times value="true"/>
        <statistic-output value="stats.intr.xml"/>
    </output>
</configuration>
