{
  "latex-workshop.latex.tools": [
    {
      "name": "pdflatex",
      "command": "/Library/TeX/texbin/pdflatex",
      "args": [
        "-synctex=1",
        "-interaction=nonstopmode",
        "-file-line-error",
        "%DOC%"
      ],
      "env": {
        "PATH": "/Library/TeX/texbin:${env:PATH}"
      }
    },
    {
      "name": "bibtex",
      "command": "/Library/TeX/texbin/bibtex",
      "args": ["%DOCFILE%"],
      "env": {
        "PATH": "/Library/TeX/texbin:${env:PATH}"
      }
    }
  ],
  "latex-workshop.latex.recipes": [
    {
      "name": "pdflatex × 2",
      "tools": ["pdflatex", "pdflatex"]
    },
    {
      "name": "pdflatex → bibtex → pdflatex × 2",
      "tools": ["pdflatex", "bibtex", "pdflatex", "pdflatex"]
    }
  ],
  "latex-workshop.latex.recipe.default": "pdflatex → bibtex → pdflatex × 2",
  "latex-workshop.latex.autoBuild.run": "onSave",
  "latex-workshop.latex.clean.subfolder.enabled": false,
  "latex-workshop.view.pdf.viewer": "tab",
  "latex-workshop.latex.outDir": ".",
  "latex-workshop.latex.rootFile.doNotPrompt": true
}
