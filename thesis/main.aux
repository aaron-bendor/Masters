\newlabel{alg:filter@cref}{{[algorithm][1][]1}{[1][11][]11}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Partial-observation routing-influence filter (schematic specification of Algorithm~\ref {alg:filter}). Inputs (blue) are a road graph and partial regime observations at $X_{\!o}$; the inverse-MC estimator fits one chain per regime; the transition contrast feeds the log-likelihood-ratio scorer, which together with the threshold $\eta $ emits a per-trajectory filter decision (green). Diagnostic audits (grey, dashed) flag whether the decision should be trusted: per-row Pearson/cosine against a full-observation empirical reference, OD-rebalancing sensitivity, multistart basin checks, and an empirical $2$-step memory audit.}}{12}{figure.caption.9}\protected@file@percent }
\newlabel{fig:filter-schematic}{{1}{12}{Partial-observation routing-influence filter (schematic specification of Algorithm~\ref {alg:filter}). Inputs (blue) are a road graph and partial regime observations at $\Xo $; the inverse-MC estimator fits one chain per regime; the transition contrast feeds the log-likelihood-ratio scorer, which together with the threshold $\eta $ emits a per-trajectory filter decision (green). Diagnostic audits (grey, dashed) flag whether the decision should be trusted: per-row Pearson/cosine against a full-observation empirical reference, OD-rebalancing sensitivity, multistart basin checks, and an empirical $2$-step memory audit}{figure.caption.9}{}}
\newlabel{fig:filter-schematic@cref}{{[figure][1][]1}{[1][11][]12}{}{}{}}
