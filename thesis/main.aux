\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Tier~3 Xuancheng rush-vs-off-peak detection AUC across three configurations. The full-observation empirical $1$-step reference (grey) is $0.556$ on a single day, $0.573$ when $5$ weekdays are pooled, and $0.518$ once the pools are OD-matched at $K=8$ spatial zones. The apparent crash at $K=8$ is \emph  {not} stable across zone granularity: a sweep over $K \in \{8, 16, 32, 64\}$ (\cref  {tab:phase5-ksweep}) shows the matched reference returning to $\sim \!0.55$--$0.58$ for $K \ge 16$. We therefore do not treat the $K=8$ drop as a fixed OD-mix fraction. Fitted detectors (blue bars) sit at or below chance in all three configurations.}}{21}{figure.caption.32}\protected@file@percent }
\newlabel{fig:phase5-headline}{{6}{21}{Tier~3 Xuancheng rush-vs-off-peak detection AUC across three configurations. The full-observation empirical $1$-step reference (grey) is $0.556$ on a single day, $0.573$ when $5$ weekdays are pooled, and $0.518$ once the pools are OD-matched at $K=8$ spatial zones. The apparent crash at $K=8$ is \emph {not} stable across zone granularity: a sweep over $K \in \{8, 16, 32, 64\}$ (\cref {tab:phase5-ksweep}) shows the matched reference returning to $\sim \!0.55$--$0.58$ for $K \ge 16$. We therefore do not treat the $K=8$ drop as a fixed OD-mix fraction. Fitted detectors (blue bars) sit at or below chance in all three configurations}{figure.caption.32}{}}
\newlabel{fig:phase5-headline@cref}{{[figure][6][]6}{[1][20][]21}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Xuancheng rush-vs-off-peak detector AUC and chain-recovery metrics on \texttt  {[all branching]} states, three configurations (\cref  {fig:phase5-headline}).}}{21}{table.caption.33}\protected@file@percent }
\newlabel{tab:phase5-headline}{{9}{21}{Xuancheng rush-vs-off-peak detector AUC and chain-recovery metrics on \texttt {[all branching]} states, three configurations (\cref {fig:phase5-headline})}{table.caption.33}{}}
\newlabel{tab:phase5-headline@cref}{{[table][9][]9}{[1][21][]21}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces OD-zone granularity sweep on the $5$-day pooled rush-vs-off-peak contrast ($T=10$, \texttt  {features=none}), with stratified vehicle-level bootstrap $95\%$ confidence intervals (CIs) ($B=2{,}000$ resamples of the test trajectories within each regime). The OD-matched full-observation reference is \emph  {not} stable across $K$: at the coarse $K=8$ it falls to chance, but at $K \ge 16$ it returns to $\sim \!0.55$--$0.58$, statistically above chance and close to the un-matched $0.573$, so fine-grained OD control removes almost none of the contrast. The fitted $1$-step partial-observation detector, by contrast, straddles chance at \emph  {every} $K$.}}{22}{table.caption.34}\protected@file@percent }
\newlabel{tab:phase5-ksweep}{{10}{22}{OD-zone granularity sweep on the $5$-day pooled rush-vs-off-peak contrast ($T=10$, \code {features=none}), with stratified vehicle-level bootstrap $95\%$ confidence intervals (CIs) ($B=2{,}000$ resamples of the test trajectories within each regime). The OD-matched full-observation reference is \emph {not} stable across $K$: at the coarse $K=8$ it falls to chance, but at $K \ge 16$ it returns to $\sim \!0.55$--$0.58$, statistically above chance and close to the un-matched $0.573$, so fine-grained OD control removes almost none of the contrast. The fitted $1$-step partial-observation detector, by contrast, straddles chance at \emph {every} $K$}{table.caption.34}{}}
\newlabel{tab:phase5-ksweep@cref}{{[table][10][]10}{[1][21][]22}{}{}{}}
