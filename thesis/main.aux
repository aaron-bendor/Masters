\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Tier~2 features lift on SUMO bigger-bbox, seed~$42$, $T=20$. Every metric --- detection AUC, gap-closed, per-row Pearson, per-row cosine median, fraction of rows with positive cosine --- moves positively under \texttt  {features=real} (dark) vs.\ \texttt  {features=none} (light). The Pearson +63\% relative lift and the cosine median $4.6\times $ lift on the \texttt  {[all branching]} generalisation block are the cleanest evidence that chain recovery, not aggregate-bias drift, is what features improve.}}{13}{figure.caption.4}\protected@file@percent }
\newlabel{fig:phase4-features-lift}{{2}{13}{Tier~2 features lift on SUMO bigger-bbox, seed~$42$, $T=20$. Every metric --- detection AUC, gap-closed, per-row Pearson, per-row cosine median, fraction of rows with positive cosine --- moves positively under \code {features=real} (dark) vs.\ \code {features=none} (light). The Pearson +63\% relative lift and the cosine median $4.6\times $ lift on the \texttt {[all branching]} generalisation block are the cleanest evidence that chain recovery, not aggregate-bias drift, is what features improve}{figure.caption.4}{}}
\newlabel{fig:phase4-features-lift@cref}{{[figure][2][]2}{[1][12][]13}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Features lift across all metrics on the SUMO bigger-bbox, seed=42 (\cref  {fig:phase4-features-lift}). \texttt  {[all branching]} restricts the per-row diagnostic to states with $\mathrm  {out\text  {-}deg} > 1$ that the inverter did \emph  {not} directly observe --- the generalisation block.}}{13}{table.caption.5}\protected@file@percent }
\newlabel{tab:phase4-features}{{3}{13}{Features lift across all metrics on the SUMO bigger-bbox, seed=42 (\cref {fig:phase4-features-lift}). \texttt {[all branching]} restricts the per-row diagnostic to states with $\mathrm {out\text {-}deg} > 1$ that the inverter did \emph {not} directly observe --- the generalisation block}{table.caption.5}{}}
\newlabel{tab:phase4-features@cref}{{[table][3][]3}{[1][13][]13}{}{}{}}
