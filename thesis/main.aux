\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Tier~2 features lift on SUMO bigger-bbox, seed~$42$, $T=20$. Every metric --- detection AUC, gap-closed, per-row Pearson, per-row cosine median, fraction of rows with positive cosine --- moves positively under \texttt  {features=real} (dark) vs.\ \texttt  {features=none} (light). The Pearson +63\% relative lift and the cosine median $4.6\times $ lift on the \texttt  {[all branching]} generalisation block are the cleanest evidence that chain recovery, not aggregate-bias drift, is what features improve.}}{19}{figure.caption.12}\protected@file@percent }
\newlabel{fig:phase4-features-lift}{{3}{19}{Tier~2 features lift on SUMO bigger-bbox, seed~$42$, $T=20$. Every metric --- detection AUC, gap-closed, per-row Pearson, per-row cosine median, fraction of rows with positive cosine --- moves positively under \code {features=real} (dark) vs.\ \code {features=none} (light). The Pearson +63\% relative lift and the cosine median $4.6\times $ lift on the \texttt {[all branching]} generalisation block are the cleanest evidence that chain recovery, not aggregate-bias drift, is what features improve}{figure.caption.12}{}}
\newlabel{fig:phase4-features-lift@cref}{{[figure][3][]3}{[1][19][]19}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Features lift across all metrics on the SUMO bigger-bbox, seed=42 (\cref  {fig:phase4-features-lift}). \texttt  {[all branching]} restricts the per-row diagnostic to states with $\mathrm  {out\text  {-}deg} > 1$ that the inverter did \emph  {not} directly observe --- the generalisation block.}}{19}{table.caption.13}\protected@file@percent }
\newlabel{tab:phase4-features}{{3}{19}{Features lift across all metrics on the SUMO bigger-bbox, seed=42 (\cref {fig:phase4-features-lift}). \texttt {[all branching]} restricts the per-row diagnostic to states with $\mathrm {out\text {-}deg} > 1$ that the inverter did \emph {not} directly observe --- the generalisation block}{table.caption.13}{}}
\newlabel{tab:phase4-features@cref}{{[table][3][]3}{[1][19][]19}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Multi-seed validation: chain recovery is robust, detection AUC is not}{20}{subsection.6.3}\protected@file@percent }
\newlabel{sec:phase4-multiseed}{{6.3}{20}{Multi-seed validation: chain recovery is robust, detection AUC is not}{subsection.6.3}{}}
\newlabel{sec:phase4-multiseed@cref}{{[subsection][3][6]6.3}{[1][20][]20}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Multi-seed Tier~2 features sweep (five SUMO seeds, \texttt  {[all branching]} block, $T=20$). \textbf  {(a)} The aggregate detection metric (gap-closed) lifts under \texttt  {features=real} on four seeds but \emph  {reverses} on seed~$101$; the \texttt  {features=none} bars also reproduce the bimodal basin structure ($\{7,23\}$ low, $\{42,101,2024\}$ high). \textbf  {(b)} The per-row chain-recovery metric (stacked Pearson) lifts on \emph  {all five} seeds. Features are a robust chain-recovery lever, not a robust aggregate-detection lever.}}{20}{figure.caption.14}\protected@file@percent }
\newlabel{fig:phase4-multiseed}{{4}{20}{Multi-seed Tier~2 features sweep (five SUMO seeds, \texttt {[all branching]} block, $T=20$). \textbf {(a)} The aggregate detection metric (gap-closed) lifts under \code {features=real} on four seeds but \emph {reverses} on seed~$101$; the \code {features=none} bars also reproduce the bimodal basin structure ($\{7,23\}$ low, $\{42,101,2024\}$ high). \textbf {(b)} The per-row chain-recovery metric (stacked Pearson) lifts on \emph {all five} seeds. Features are a robust chain-recovery lever, not a robust aggregate-detection lever}{figure.caption.14}{}}
\newlabel{fig:phase4-multiseed@cref}{{[figure][4][]4}{[1][20][]20}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Multi-seed features sweep on SUMO bigger-bbox (\cref  {fig:phase4-multiseed}), \texttt  {[all branching]} block, $T=20$, $|X_o|=601$. The AUC lift reverses on seed~$101$; the Pearson lift is positive on all five seeds. Mean~$\Delta $ rows are \texttt  {real}~$-$~\texttt  {none} with sample standard deviation.}}{20}{table.caption.15}\protected@file@percent }
\newlabel{tab:phase4-multiseed}{{4}{20}{Multi-seed features sweep on SUMO bigger-bbox (\cref {fig:phase4-multiseed}), \texttt {[all branching]} block, $T=20$, $|X_o|=601$. The AUC lift reverses on seed~$101$; the Pearson lift is positive on all five seeds. Mean~$\Delta $ rows are \code {real}~$-$~\code {none} with sample standard deviation}{table.caption.15}{}}
\newlabel{tab:phase4-multiseed@cref}{{[table][4][]4}{[1][20][]20}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.4}Multistart basin check: the low basin is not an initialisation artefact}{21}{subsection.6.4}\protected@file@percent }
\newlabel{sec:phase4-multistart}{{6.4}{21}{Multistart basin check: the low basin is not an initialisation artefact}{subsection.6.4}{}}
\newlabel{sec:phase4-multistart@cref}{{[subsection][4][6]6.4}{[1][21][]21}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Tier~2 multistart basin check on the two low-basin seeds (\texttt  {features=none}, $K = 5$, $T = 20$). \textbf  {(a)} The val-selected multistart detector ties the zero-init baseline on seed~$7$ and is markedly worse on seed~$23$; neither approaches the $\sim 61\%$ good-basin level of seeds $\{42, 101, 2024\}$ (dashed). \textbf  {(b)} Every one of the ten random restarts (five per regime) converges to a strictly \emph  {higher} final loss than zero-init --- so zero-init is the best optimum found, and the low basin is not an initialisation artefact.}}{21}{figure.caption.16}\protected@file@percent }
\newlabel{fig:phase4-multistart}{{5}{21}{Tier~2 multistart basin check on the two low-basin seeds (\code {features=none}, $K = 5$, $T = 20$). \textbf {(a)} The val-selected multistart detector ties the zero-init baseline on seed~$7$ and is markedly worse on seed~$23$; neither approaches the $\sim 61\%$ good-basin level of seeds $\{42, 101, 2024\}$ (dashed). \textbf {(b)} Every one of the ten random restarts (five per regime) converges to a strictly \emph {higher} final loss than zero-init --- so zero-init is the best optimum found, and the low basin is not an initialisation artefact}{figure.caption.16}{}}
\newlabel{fig:phase4-multistart@cref}{{[figure][5][]5}{[1][21][]21}{}{}{}}
