\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces Cross-tier synthesis of the three validation tiers. The single pipeline of \cref  {sec:disc-cross-tier} produces every row; only the data changes. Tier~2 is the representative seed~$42$ at $T=20$ (\cref  {tab:phase4-features}); Tier~3 is the pooled Apr~17--21 pool at $T=10$ (\cref  {tab:phase5-headline}). Fitted and Pearson cells are \texttt  {none}/\texttt  {real}. $^{\dagger }$Tier~1 is a $\pi $-recovery reproduction scored by RMAE, not a detection AUC: best RMAE $0.19$ at $|X_o|=70$, within $\sim 0.05$ of the paper's Fig.~2A (\cref  {tab:phase1-rmae}). $^{\ddagger }$OD-matching crashes the Tier-3 ceiling from $0.573$ to $0.518$ ($0.018$ above chance), attributing $\sim 75\%$ of the pooled signal to OD-mix rather than routing (\cref  {sec:phase5-reading}). The Tier-2 Pearson lift is robust across five seeds ($\Delta = +0.050 \pm 0.023$, $p \approx 0.008$, \cref  {sec:phase4-multiseed}).}}{26}{table.caption.22}\protected@file@percent }
\newlabel{tab:cross-tier}{{9}{26}{Cross-tier synthesis of the three validation tiers. The single pipeline of \cref {sec:disc-cross-tier} produces every row; only the data changes. Tier~2 is the representative seed~$42$ at $T=20$ (\cref {tab:phase4-features}); Tier~3 is the pooled Apr~17--21 pool at $T=10$ (\cref {tab:phase5-headline}). Fitted and Pearson cells are \code {none}/\code {real}. $^{\dagger }$Tier~1 is a $\pi $-recovery reproduction scored by RMAE, not a detection AUC: best RMAE $0.19$ at $|X_o|=70$, within $\sim 0.05$ of the paper's Fig.~2A (\cref {tab:phase1-rmae}). $^{\ddagger }$OD-matching crashes the Tier-3 ceiling from $0.573$ to $0.518$ ($0.018$ above chance), attributing $\sim 75\%$ of the pooled signal to OD-mix rather than routing (\cref {sec:phase5-reading}). The Tier-2 Pearson lift is robust across five seeds ($\Delta = +0.050 \pm 0.023$, $p \approx 0.008$, \cref {sec:phase4-multiseed})}{table.caption.22}{}}
\newlabel{tab:cross-tier@cref}{{[table][9][]9}{[1][25][]26}{}{}{}}
