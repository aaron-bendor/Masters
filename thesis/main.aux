\newlabel{sec:phase4-features-result@cref}{{[subsection][2][6]6.2}{[1][13][]14}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Tier~2 features lift on SUMO bigger-bbox, seed~$42$, $T=20$. Every metric --- detection AUC, gap-closed, per-row Pearson, per-row cosine median, fraction of rows with positive cosine --- moves positively under \texttt  {features=real} (dark) vs.\ \texttt  {features=none} (light). The Pearson +63\% relative lift and the cosine median $4.6\times $ lift on the \texttt  {[all branching]} generalisation block are the cleanest evidence that chain recovery, not aggregate-bias drift, is what features improve.}}{14}{figure.caption.4}\protected@file@percent }
\newlabel{fig:phase4-features-lift}{{2}{14}{Tier~2 features lift on SUMO bigger-bbox, seed~$42$, $T=20$. Every metric --- detection AUC, gap-closed, per-row Pearson, per-row cosine median, fraction of rows with positive cosine --- moves positively under \code {features=real} (dark) vs.\ \code {features=none} (light). The Pearson +63\% relative lift and the cosine median $4.6\times $ lift on the \texttt {[all branching]} generalisation block are the cleanest evidence that chain recovery, not aggregate-bias drift, is what features improve}{figure.caption.4}{}}
\newlabel{fig:phase4-features-lift@cref}{{[figure][2][]2}{[1][14][]14}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Features lift across all metrics on the SUMO bigger-bbox, seed=42 (\cref  {fig:phase4-features-lift}). \texttt  {[all branching]} restricts the per-row diagnostic to states with $\mathrm  {out\text  {-}deg} > 1$ that the inverter did \emph  {not} directly observe --- the generalisation block.}}{14}{table.caption.5}\protected@file@percent }
\newlabel{tab:phase4-features}{{3}{14}{Features lift across all metrics on the SUMO bigger-bbox, seed=42 (\cref {fig:phase4-features-lift}). \texttt {[all branching]} restricts the per-row diagnostic to states with $\mathrm {out\text {-}deg} > 1$ that the inverter did \emph {not} directly observe --- the generalisation block}{table.caption.5}{}}
\newlabel{tab:phase4-features@cref}{{[table][3][]3}{[1][14][]14}{}{}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {6.3}Multi-seed validation: chain recovery is robust, detection AUC is not}{15}{subsection.6.3}\protected@file@percent }
\newlabel{sec:phase4-multiseed}{{6.3}{15}{Multi-seed validation: chain recovery is robust, detection AUC is not}{subsection.6.3}{}}
\newlabel{sec:phase4-multiseed@cref}{{[subsection][3][6]6.3}{[1][15][]15}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Multi-seed Tier~2 features sweep (five SUMO seeds, \texttt  {[all branching]} block, $T=20$). \textbf  {(a)} The aggregate detection metric (gap-closed) lifts under \texttt  {features=real} on four seeds but \emph  {reverses} on seed~$101$; the \texttt  {features=none} bars also reproduce the bimodal basin structure ($\{7,23\}$ low, $\{42,101,2024\}$ high). \textbf  {(b)} The per-row chain-recovery metric (stacked Pearson) lifts on \emph  {all five} seeds. Features are a robust chain-recovery lever, not a robust aggregate-detection lever.}}{15}{figure.caption.6}\protected@file@percent }
\newlabel{fig:phase4-multiseed}{{3}{15}{Multi-seed Tier~2 features sweep (five SUMO seeds, \texttt {[all branching]} block, $T=20$). \textbf {(a)} The aggregate detection metric (gap-closed) lifts under \code {features=real} on four seeds but \emph {reverses} on seed~$101$; the \code {features=none} bars also reproduce the bimodal basin structure ($\{7,23\}$ low, $\{42,101,2024\}$ high). \textbf {(b)} The per-row chain-recovery metric (stacked Pearson) lifts on \emph {all five} seeds. Features are a robust chain-recovery lever, not a robust aggregate-detection lever}{figure.caption.6}{}}
\newlabel{fig:phase4-multiseed@cref}{{[figure][3][]3}{[1][15][]15}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Multi-seed features sweep on SUMO bigger-bbox (\cref  {fig:phase4-multiseed}), \texttt  {[all branching]} block, $T=20$, $|X_o|=601$. The AUC lift reverses on seed~$101$; the Pearson lift is positive on all five seeds. Mean~$\Delta $ rows are \texttt  {real}~$-$~\texttt  {none} with sample standard deviation.}}{15}{table.caption.7}\protected@file@percent }
\newlabel{tab:phase4-multiseed}{{4}{15}{Multi-seed features sweep on SUMO bigger-bbox (\cref {fig:phase4-multiseed}), \texttt {[all branching]} block, $T=20$, $|X_o|=601$. The AUC lift reverses on seed~$101$; the Pearson lift is positive on all five seeds. Mean~$\Delta $ rows are \code {real}~$-$~\code {none} with sample standard deviation}{table.caption.7}{}}
\newlabel{tab:phase4-multiseed@cref}{{[table][4][]4}{[1][15][]15}{}{}{}}
