\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces $\gamma $ sweep for f+g on the Xuancheng K=8 zone-0 subgraph ($n=194$, $|X_o|=53$, $T=10$, $\texttt  {maxiter}=300$). The f-only column is the same fit ($\gamma =1$) shown for reference; the empirical 1-step ceiling on this subgraph is $0.563$. f+g \emph  {hurts} at $\gamma =0.5$--$0.7$ (the floor-dominated $L_h$ overwhelms $L_f$) and recovers the empirical reference within sampling noise at $\gamma =0.95$.}}{23}{table.caption.27}\protected@file@percent }
