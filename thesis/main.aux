\@writefile{toc}{\contentsline {paragraph}{Sparse-LU implementation.}{21}{paragraph*.23}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{At SUMO bigger-bbox scale, naive sparse is \emph  {slower} than dense.}{22}{paragraph*.24}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{At Xuancheng subgraph scale, sparse-LU runs in seconds and $f+g$ is tractable.}{22}{paragraph*.25}\protected@file@percent }
