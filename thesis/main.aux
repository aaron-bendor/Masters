\@writefile{toc}{\contentsline {subsection}{\numberline {6.6}Trajectory-length sweep: lifting the ceiling and the detector together}{18}{subsection.6.6}\protected@file@percent }
\newlabel{sec:phase4-tsweep}{{6.6}{18}{Trajectory-length sweep: lifting the ceiling and the detector together}{subsection.6.6}{}}
\newlabel{sec:phase4-tsweep@cref}{{[subsection][6][6]6.6}{[1][18][]18}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Tier~2 $T$-sweep on SUMO bigger-bbox, seed~$42$, \texttt  {features=real}. The empirical $1$-step Markov ceiling (grey dashed) rises with $T$ as expected for a variance-shrinking score; the fitted detector (blue solid) tracks it with roughly constant gap. The shaded region is the recoverable contrast not yet captured by the fitter. The fitted chain itself is $T$-independent (identical final losses across runs); only the trajectory-level scoring window changes.}}{19}{figure.caption.10}\protected@file@percent }
\newlabel{fig:phase4-tsweep}{{5}{19}{Tier~2 $T$-sweep on SUMO bigger-bbox, seed~$42$, \code {features=real}. The empirical $1$-step Markov ceiling (grey dashed) rises with $T$ as expected for a variance-shrinking score; the fitted detector (blue solid) tracks it with roughly constant gap. The shaded region is the recoverable contrast not yet captured by the fitter. The fitted chain itself is $T$-independent (identical final losses across runs); only the trajectory-level scoring window changes}{figure.caption.10}{}}
\newlabel{fig:phase4-tsweep@cref}{{[figure][5][]5}{[1][18][]19}{}{}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces $T$-sweep on SUMO bigger-bbox, seed=42, \texttt  {features=real} (\cref  {fig:phase4-tsweep}). The fit itself is $T$-independent --- only the test scoring window changes --- as confirmed by the identical final-loss values $836.4 / 529.4$ across all three runs.}}{19}{table.caption.11}\protected@file@percent }
\newlabel{tab:phase4-tsweep}{{6}{19}{$T$-sweep on SUMO bigger-bbox, seed=42, \code {features=real} (\cref {fig:phase4-tsweep}). The fit itself is $T$-independent --- only the test scoring window changes --- as confirmed by the identical final-loss values $836.4 / 529.4$ across all three runs}{table.caption.11}{}}
\newlabel{tab:phase4-tsweep@cref}{{[table][6][]6}{[1][19][]19}{}{}{}}
