\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Xuancheng Labour-Day-versus-normal stress test ($T=10$, \texttt  {features=none}, $B=2{,}000$ bootstrap resamples). The unmatched row contains a clear global signal, part of which is OD/population mix. At fine OD matching ($K=64$), a statistically significant within-OD full-observation signal remains, but the fitted partial-observation detector stays near chance and multistart validation selection removes the small single-init lift.}}{29}{table.caption.36}\protected@file@percent }
\newlabel{tab:phase5-labour}{{12}{29}{Xuancheng Labour-Day-versus-normal stress test ($T=10$, \code {features=none}, $B=2{,}000$ bootstrap resamples). The unmatched row contains a clear global signal, part of which is OD/population mix. At fine OD matching ($K=64$), a statistically significant within-OD full-observation signal remains, but the fitted partial-observation detector stays near chance and multistart validation selection removes the small single-init lift}{table.caption.36}{}}
