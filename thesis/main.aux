\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Cross-tier synthesis of the three validation tiers. The shared inverse-MC scoring core of \cref  {sec:disc-cross-tier} produces every row; the loader, regime definition, and OD-control logic differ by tier. Tier~2 is the representative seed~$42$ at $T=20$ (\cref  {tab:phase4-features}); Tier~3 is the pooled Apr~17--21 pool at $T=10$ (\cref  {tab:phase5-headline}). Fitted and Pearson cells are \texttt  {none}/\texttt  {real}. $^{\dagger }$Tier~1 is a $\pi $-recovery reproduction scored by RMAE, not a detection AUC: best RMAE $0.19$ at $|X_o|=70$, within $\sim 0.05$ of the paper's Fig.~2A (\cref  {tab:phase1-rmae}). $^{\ddagger }$The Tier-3 ceiling shown is the un-matched $5$-day pool. OD-matching at $K=8$ lowers it to $0.518$, but a granularity sweep $K \in \{8, 16, 32, 64\}$ returns the matched reference to $\sim \!0.55$--$0.58$ for $K \ge 16$, so no fixed OD-mix fraction is claimed; the fitted detector stays at chance across all $K$ (\cref  {tab:phase5-ksweep}). The Tier-2 Pearson lift is robust across five seeds ($\Delta = +0.050 \pm 0.023$, $p \approx 0.008$, \cref  {sec:phase4-multiseed}).}}{32}{table.caption.35}\protected@file@percent }
\newlabel{tab:cross-tier}{{11}{32}{Cross-tier synthesis of the three validation tiers. The shared inverse-MC scoring core of \cref {sec:disc-cross-tier} produces every row; the loader, regime definition, and OD-control logic differ by tier. Tier~2 is the representative seed~$42$ at $T=20$ (\cref {tab:phase4-features}); Tier~3 is the pooled Apr~17--21 pool at $T=10$ (\cref {tab:phase5-headline}). Fitted and Pearson cells are \code {none}/\code {real}. $^{\dagger }$Tier~1 is a $\pi $-recovery reproduction scored by RMAE, not a detection AUC: best RMAE $0.19$ at $|X_o|=70$, within $\sim 0.05$ of the paper's Fig.~2A (\cref {tab:phase1-rmae}). $^{\ddagger }$The Tier-3 ceiling shown is the un-matched $5$-day pool. OD-matching at $K=8$ lowers it to $0.518$, but a granularity sweep $K \in \{8, 16, 32, 64\}$ returns the matched reference to $\sim \!0.55$--$0.58$ for $K \ge 16$, so no fixed OD-mix fraction is claimed; the fitted detector stays at chance across all $K$ (\cref {tab:phase5-ksweep}). The Tier-2 Pearson lift is robust across five seeds ($\Delta = +0.050 \pm 0.023$, $p \approx 0.008$, \cref {sec:phase4-multiseed})}{table.caption.35}{}}
\newlabel{tab:cross-tier@cref}{{[table][11][]11}{[1][32][]32}{}{}{}}
