\@writefile{toc}{\contentsline {subsection}{\numberline {6.6}Trajectory-length sweep: lifting the ceiling and the detector together}{23}{subsection.6.6}\protected@file@percent }
\newlabel{sec:phase4-tsweep}{{6.6}{23}{Trajectory-length sweep: lifting the ceiling and the detector together}{subsection.6.6}{}}
\newlabel{sec:phase4-tsweep@cref}{{[subsection][6][6]6.6}{[1][22][]23}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Tier~2 $T$-sweep on SUMO bigger-bbox, seed~$42$, \texttt  {features=real}. The empirical $1$-step Markov ceiling (grey dashed) rises with $T$ as expected for a variance-shrinking score; the fitted detector (blue solid) tracks it with roughly constant gap. The shaded region is the recoverable contrast not yet captured by the fitter. The fitted chain itself is $T$-independent (identical final losses across runs); only the trajectory-level scoring window changes.}}{23}{figure.caption.18}\protected@file@percent }
\newlabel{fig:phase4-tsweep}{{6}{23}{Tier~2 $T$-sweep on SUMO bigger-bbox, seed~$42$, \code {features=real}. The empirical $1$-step Markov ceiling (grey dashed) rises with $T$ as expected for a variance-shrinking score; the fitted detector (blue solid) tracks it with roughly constant gap. The shaded region is the recoverable contrast not yet captured by the fitter. The fitted chain itself is $T$-independent (identical final losses across runs); only the trajectory-level scoring window changes}{figure.caption.18}{}}
