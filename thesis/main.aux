\@writefile{toc}{\contentsline {subsubsection}{\numberline {5.4.1}Multistart on \texttt  {features=real}: the ceiling violation is an optimiser artefact}{31}{subsubsection.5.4.1}\protected@file@percent }
\newlabel{sec:phase5-multistart}{{5.4.1}{31}{Multistart on \code {features=real}: the ceiling violation is an optimiser artefact}{subsubsection.5.4.1}{}}
\newlabel{sec:phase5-multistart@cref}{{[subsubsection][1][5,4]5.4.1}{[1][31][]31}{}{}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Xuancheng OD-matched \texttt  {features=real} multistart ($K=5$). \textbf  {(a)} The rush-chain training loss collapses from the zero-init baseline ($1{,}397$) to the validation-selected restart ($9.186$): random re-initialisation \emph  {escapes} the high-loss basin, unlike the SUMO case (\cref  {sec:phase4-multistart}). \textbf  {(b)} Despite the proper fit, $\mathrm  {AUC}_{\mathrm  {fit}}$ falls from the baseline's spurious $0.530$ (which exceeded the empirical ceiling $0.518$) to $0.483$ -- chance. The ceiling violation was an optimiser artefact; under correct chain recovery the fitted detector returns to chance.}}{31}{figure.caption.40}\protected@file@percent }
\newlabel{fig:phase5-multistart}{{7}{31}{Xuancheng OD-matched \code {features=real} multistart ($K=5$). \textbf {(a)} The rush-chain training loss collapses from the zero-init baseline ($1{,}397$) to the validation-selected restart ($9.186$): random re-initialisation \emph {escapes} the high-loss basin, unlike the SUMO case (\cref {sec:phase4-multistart}). \textbf {(b)} Despite the proper fit, $\AUC _{\mathrm {fit}}$ falls from the baseline's spurious $0.530$ (which exceeded the empirical ceiling $0.518$) to $0.483$ -- chance. The ceiling violation was an optimiser artefact; under correct chain recovery the fitted detector returns to chance}{figure.caption.40}{}}
\newlabel{fig:phase5-multistart@cref}{{[figure][7][]7}{[1][31][]31}{}{}{}}
