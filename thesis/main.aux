\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Tier~3 Xuancheng rush-vs-off-peak detection AUC across three configurations. The empirical $1$-step Markov ceiling (grey) is $0.556$ on a single day, lifts to $0.573$ when $5$ weekdays are pooled, and \emph  {crashes} to $0.518$ once the pools are OD-matched at $K=8$ spatial zones. The $0.055$ AUC drop attributable to the OD-rebalancing identifies approximately $75\,\%$ of the un-matched detection signal as origin-destination-mix between commuter and discretionary trip populations, not routing-choice differences. Fitted detectors (blue bars) follow the ceiling in all three configurations.}}{20}{figure.caption.14}\protected@file@percent }
\newlabel{fig:phase5-headline}{{5}{20}{Tier~3 Xuancheng rush-vs-off-peak detection AUC across three configurations. The empirical $1$-step Markov ceiling (grey) is $0.556$ on a single day, lifts to $0.573$ when $5$ weekdays are pooled, and \emph {crashes} to $0.518$ once the pools are OD-matched at $K=8$ spatial zones. The $0.055$ AUC drop attributable to the OD-rebalancing identifies approximately $75\,\%$ of the un-matched detection signal as origin-destination-mix between commuter and discretionary trip populations, not routing-choice differences. Fitted detectors (blue bars) follow the ceiling in all three configurations}{figure.caption.14}{}}
\newlabel{fig:phase5-headline@cref}{{[figure][5][]5}{[1][19][]20}{}{}{}}
