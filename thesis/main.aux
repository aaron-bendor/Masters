\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Tier~3 Xuancheng rush-vs-off-peak detection AUC across three configurations. The full-observation empirical $1$-step reference (grey) is $0.556$ on a single day, $0.573$ when $5$ weekdays are pooled, and $0.518$ once the pools are OD-matched at $K=8$ spatial zones. The apparent crash at $K=8$ is not stable across zone granularity: a sweep over $K \in \{8, 16, 32, 64\}$ (\cref  {tab:phase5-ksweep}) shows the matched reference returning to $\sim \!0.55$--$0.58$ for $K \ge 16$. The $K=8$ drop is therefore not treated as a fixed OD-mix fraction. Fitted detectors (blue bars) sit at or below chance in all three configurations.}}{23}{figure.caption.19}\protected@file@percent }
\newlabel{fig:phase5-headline}{{5}{23}{Tier~3 Xuancheng rush-vs-off-peak detection AUC across three configurations. The full-observation empirical $1$-step reference (grey) is $0.556$ on a single day, $0.573$ when $5$ weekdays are pooled, and $0.518$ once the pools are OD-matched at $K=8$ spatial zones. The apparent crash at $K=8$ is not stable across zone granularity: a sweep over $K \in \{8, 16, 32, 64\}$ (\cref {tab:phase5-ksweep}) shows the matched reference returning to $\sim \!0.55$--$0.58$ for $K \ge 16$. The $K=8$ drop is therefore not treated as a fixed OD-mix fraction. Fitted detectors (blue bars) sit at or below chance in all three configurations}{figure.caption.19}{}}
\newlabel{fig:phase5-headline@cref}{{[figure][5][]5}{[1][22][]23}{}{}{}}
